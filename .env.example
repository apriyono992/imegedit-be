# HTTP
PORT=3000
# Origin frontend yang diizinkan (pisah dengan koma). Kosongkan = izinkan semua.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
